<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="robot_gripper" params="gripper_span">

    <!-- Main gripper body: mass 0.5 kg -->
    <link name="gripper_mount_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.5"/>
        <inertia
          ixx="0.00104" ixy="0" ixz="0"
          iyy="0.00054" iyz="0"
          izz="0.00104"/>
      </inertial>

      <visual>
        <geometry>
          <box size="0.08 0.14 0.06"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.08 0.14 0.06"/>
        </geometry>
      </collision>
    </link>

    <joint name="gripper_mount_joint" type="fixed">
      <parent link="arm_tip_link"/>
      <child link="gripper_mount_link"/>
      <origin xyz="0.03 0 0" rpy="0 0 0"/>
    </joint>


    <!-- Left finger: mass 0.15 kg -->
    <link name="left_finger_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia
          ixx="0.00019" ixy="0" ixz="0"
          iyy="0.00011" iyz="0"
          izz="0.00011"/>
      </inertial>

      <visual>
        <geometry>
          <box size="0.08 0.025 0.12"/>
        </geometry>
        <material name="finger_material">
          <color rgba="0.1 0.7 0.2 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.08 0.025 0.12"/>
        </geometry>
      </collision>
    </link>

    <joint name="left_finger_joint" type="prismatic">
      <parent link="gripper_mount_link"/>
      <child link="left_finger_link"/>
      <origin xyz="0 ${gripper_span/2 + 0.0125} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.01" upper="0" effort="50" velocity="0.1"/>
    </joint>


    <!-- Right finger: mass 0.15 kg -->
    <link name="right_finger_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.15"/>
        <inertia
          ixx="0.00019" ixy="0" ixz="0"
          iyy="0.00011" iyz="0"
          izz="0.00011"/>
      </inertial>

      <visual>
        <geometry>
          <box size="0.08 0.025 0.12"/>
        </geometry>
        <material name="finger_material">
          <color rgba="0.1 0.7 0.2 1"/>
        </material>
      </visual>

      <collision>
        <geometry>
          <box size="0.08 0.025 0.12"/>
        </geometry>
      </collision>
    </link>

    <joint name="right_finger_joint" type="prismatic">
      <parent link="gripper_mount_link"/>
      <child link="right_finger_link"/>
      <origin xyz="0 -${gripper_span/2 + 0.0125} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0" upper="0.01" effort="50" velocity="0.1"/>
    </joint>

  </xacro:macro>
</robot>

<?xml version="1.0"?>
<robot name="eva_drink_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Robot parameters -->
  <xacro:property name="base_radius" value="0.20"/>
  <xacro:property name="base_height" value="0.30"/>
  <xacro:property name="base_mass" value="20.0"/>
  <xacro:property name="link1_length" value="0.75"/>
  <xacro:property name="link2_length" value="0.50"/>
  <xacro:property name="gripper_span" value="0.12"/>

  <!-- Include component files -->
  <xacro:include filename="base.xacro"/>
  <xacro:include filename="arm.xacro"/>
  <xacro:include filename="gripper.xacro"/>

  <!-- Dummy root link -->
  <link name="world"/>

  <!-- Instantiate base -->
  <xacro:robot_base
    base_radius="${base_radius}"
    base_height="${base_height}"
    base_mass="${base_mass}"/>

  <!-- Connect world to the base created by base.xacro -->
  <joint name="world_to_base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Instantiate arm -->
  <xacro:robot_arm
    base_height="${base_height}"
    link1_length="${link1_length}"
    link2_length="${link2_length}"/>

  <!-- Instantiate gripper -->
  <xacro:robot_gripper gripper_span="${gripper_span}"/>

</robot>
